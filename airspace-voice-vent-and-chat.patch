+# ---------- chat ----------
+def _msgs(*pairs):
+    return [{"role": r, "content": c} for r, c in pairs]
+
+
+def test_chat_paths(client, monkeypatch):
+    token = register(client, "c1@example.com")
+    body = {"messages": _msgs(("user", "rough day"))}
