CRISIS_RESOURCES='[{"name":"MANI (Mentally Aware Nigeria Initiative)","phone":"08091116264","alt_phone":"08111680686","hours":"24/7","description":"Free, confidential emotional support for anxiety, depression, and suicidal thoughts.","url":"https://mentallyaware.org"},{"name":"SURPIN (Suicide Research & Prevention Initiative)","phone":"08000787746","alt_phone":"09034400009","hours":"24/7","description":"Nationwide crisis intervention; counsellors speak major Nigerian languages.","url":"https://surpin.org"},{"name":"Safe Place Nigeria (She Writes Woman)","phone":"08008002000","hours":"24/7","description":"National toll-free crisis line with free tele-therapy referrals.","url":"https://shewriteswoman.org"},{"name":"Lagos Lifeline","phone":"07000006463","hours":"24/7","description":"Lagos State line connecting callers to psychiatric professionals.","url":"https://lagosstate.gov.ng"},{"name":"Emergency Services","phone":"112","hours":"24/7","description":"National emergency number. In Lagos, dial 767.","url":""}]'
