        ]
      }
    },
    "/api/v1/checkins": {
      "get": {
        "tags": [
          "checkins"
        ],
        "summary": "List check-ins (newest first, max 100)",
        "operationId": "list_checkins_api_v1_checkins_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CheckInResponse"
                  },
                  "type": "array",
                  "title": "Response List Checkins Api V1 Checkins Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "checkins"
        ],
        "summary": "Save a check-in",
        "operationId": "create_checkin_api_v1_checkins_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckInResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/checkins/{checkin_id}": {
      "patch": {
        "tags": [
          "checkins"
        ],
        "summary": "Update after_score / emotion / note",
        "operationId": "update_checkin_api_v1_checkins__checkin_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "checkin_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Checkin Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckInResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Check-in not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "checkins"
        ],
        "summary": "Delete a check-in",
        "operationId": "delete_checkin_api_v1_checkins__checkin_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "checkin_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Checkin Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Check-in not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/account": {
      "delete": {
        "tags": [
          "account"
        ],
        "summary": "Delete account and all check-ins",
        "operationId": "delete_account_api_v1_account_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CheckInCreate": {
        "properties": {
          "before_score": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Before Score"
          },
          "after_score": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "After Score"
          },
          "emotion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Emotion"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "before_score"
        ],
        "title": "CheckInCreate"
      },
      "CheckInResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "before_score": {
            "type": "integer",
            "title": "Before Score"
          },
          "after_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "After Score"
          },
          "emotion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emotion"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "safety_notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safety Notice"
          },
          "crisis_resources": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CrisisResource"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crisis Resources"
          }
        },
        "type": "object",
        "required": [
          "id",
          "before_score",
          "after_score",
          "emotion",
          "note",
          "created_at"
        ],
        "title": "CheckInResponse"
      },
      "CheckInUpdate": {
        "properties": {
          "after_score": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "After Score"
          },
          "emotion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Emotion"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CheckInUpdate",
        "description": "Partial update. Send only the fields to change; an explicit null clears that field."
      },
      "CrisisResource": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "alt_phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alt Phone"
          },
          "hours": {
            "type": "string",
            "title": "Hours"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "phone",
          "hours",
          "description"
        ],
        "title": "CrisisResource"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "ReframeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Text"
          },
          "prompt_style": {
            "type": "string",
            "pattern": "^(gentle|practical|reflective)$",
            "title": "Prompt Style",
            "default": "gentle"
          },
          "consent_to_ai_processing": {
            "type": "boolean",
            "title": "Consent To Ai Processing",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ReframeRequest"
      },
      "ReframeResponse": {
        "properties": {
          "reflection": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reflection"
          },
          "safety_notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safety Notice"
          },
          "crisis_resources": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CrisisResource"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crisis Resources"
          },
          "needs_human_support": {
            "type": "boolean",
            "title": "Needs Human Support",
            "default": false
          },
          "ai_enabled": {
            "type": "boolean",
            "title": "Ai Enabled"
          },
          "ai_status": {
            "type": "string",
            "enum": [
              "skipped_for_safety",
              "unavailable",
              "consent_required",
              "success",
              "fallback"
            ],
            "title": "Ai Status"
          },
          "consent_required": {
            "type": "boolean",
            "title": "Consent Required",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "ai_enabled",
          "ai_status"
        ],
        "title": "ReframeResponse"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "TokenResponse"
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "created_at"
        ],
        "title": "UserResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VentRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "VentRequest"
      },
      "VentResponse": {
        "properties": {
          "acknowledgement": {
            "type": "string",
            "title": "Acknowledgement"
          },
          "reflection_prompts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reflection Prompts"
          },
          "safety_notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safety Notice"
          },
          "crisis_resources": {
