{
  "openapi": "3.1.0",
  "info": {
    "title": "AirSpace API",
    "description": "AirSpace MVP API: vent, reflect, and track emotional check-ins.\n\nErrors: business errors are `{\"detail\": \"message\"}`; validation errors (422) return `detail` as a list of `{loc, msg, type}` objects.",
    "version": "0.3.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/crisis-resources": {
      "get": {
        "tags": [
