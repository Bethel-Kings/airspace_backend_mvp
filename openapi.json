              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CrisisResource"
                  },
                  "type": "array",
                  "title": "Response List Crisis Resources Api V1 Crisis Resources Get"
                }
              }
            }
          }
        }
      }
    },
