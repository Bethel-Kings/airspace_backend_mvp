  "components": {
    "schemas": {
      "Body_vent_voice_api_v1_vent_voice_post": {
        "properties": {
          "audio": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Audio",
            "description": "Recorded audio (webm, ogg, mp4/m4a, mp3, wav, flac)."
          },
          "consent_to_ai_processing": {
            "type": "boolean",
            "title": "Consent To Ai Processing",
            "default": false
          },
          "reflect": {
            "type": "boolean",
            "title": "Reflect",
            "description": "Also return an AI reply to the transcript.",
            "default": false
          },
          "prompt_style": {
            "type": "string",
            "pattern": "^(gentle|practical|reflective)$",
            "title": "Prompt Style",
            "default": "gentle"
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z]{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language",
            "description": "Optional ISO-639-1 hint, e.g. en, ig, yo, ha."
          }
        },
        "type": "object",
        "required": [
          "audio"
        ],
        "title": "Body_vent_voice_api_v1_vent_voice_post"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Messages"
          },
          "prompt_style": {
            "type": "string",
            "pattern": "^(gentle|practical|reflective)$",
            "title": "Prompt Style",
            "default": "gentle"
          },
          "consent_to_ai_processing": {
            "type": "boolean",
            "title": "Consent To Ai Processing",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest",
        "description": "Stateless chat: the client sends the running conversation; the server stores nothing."
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reply"
          },
          "safety_notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Safety Notice"
          },
          "crisis_resources": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CrisisResource"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Crisis Resources"
          },
          "needs_human_support": {
            "type": "boolean",
            "title": "Needs Human Support",
            "default": false
          },
          "ai_enabled": {
            "type": "boolean",
            "title": "Ai Enabled"
          },
          "ai_status": {
            "type": "string",
            "enum": [
              "skipped_for_safety",
              "unavailable",
              "consent_required",
              "success",
              "fallback"
            ],
            "title": "Ai Status"
          },
          "consent_required": {
            "type": "boolean",
            "title": "Consent Required",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "ai_enabled",
          "ai_status"
        ],
        "title": "ChatResponse"
      },
      "CheckInCreate": {
        "properties": {
          "before_score": {
            "type": "integer",
            "maximum": 10,
            "minimum": 1,
            "title": "Before Score"
          },
          "after_score": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10,
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "After Score"
          },
          "emotion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Emotion"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "before_score"
        ],
        "title": "CheckInCreate"
      },
      "CheckInResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "before_score": {
            "type": "integer",
            "title": "Before Score"
          },
          "after_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "After Score"
          },
          "emotion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emotion"
          },
          "note": {
