diff --git a/app/ratelimit.py b/app/ratelimit.py
new file mode 100644
index 0000000..3212f08
--- /dev/null
+++ b/app/ratelimit.py
@@ -0,0 +1,54 @@
+"""Minimal in-memory sliding-window rate limiter.
+
+Per-process only: fine for a single Render instance. If you scale to several
+instances, move this to Redis (or put limits at a gateway/CDN).
+"""
+import threading
+import time
+from collections import defaultdict, deque
+
+from fastapi import HTTPException, Request
+
+
+class RateLimiter:
+    def __init__(self) -> None:
+        self._hits: dict[str, deque[float]] = defaultdict(deque)
+        self._lock = threading.Lock()
+        self._calls = 0
+
+    def reset(self) -> None:
+        with self._lock:
+            self._hits.clear()
+
+    def check(self, key: str, limit: int, window_seconds: int) -> None:
+        now = time.monotonic()
+        with self._lock:
+            self._calls += 1
+            if self._calls % 1000 == 0:  # occasional sweep so idle keys don't pile up
+                for k in [k for k, q in self._hits.items() if not q or q[-1] <= now - 3600]:
+                    del self._hits[k]
+            q = self._hits[key]
+            while q and q[0] <= now - window_seconds:
+                q.popleft()
+            if len(q) >= limit:
+                retry_after = int(window_seconds - (now - q[0])) + 1
+                raise HTTPException(
+                    status_code=429,
+                    detail="Too many requests. Please try again later.",
+                    headers={"Retry-After": str(retry_after)},
+                )
+            q.append(now)
+
+
+limiter = RateLimiter()
+
+
+def client_ip(request: Request) -> str:
+    return request.client.host if request.client else "unknown"
+
+
+def ip_limit(scope: str, limit: int, window_seconds: int):
+    def dependency(request: Request) -> None:
+        limiter.check(f"{scope}:ip:{client_ip(request)}", limit, window_seconds)
+
+    return dependency
diff --git a/app/safety.py b/app/safety.py
index a86f18c..30ffb62 100644
--- a/app/safety.py
+++ b/app/safety.py
@@ -1,10 +1,21 @@
 import re
+import unicodedata
+
+from app.config import settings
 
 # Prototype-only routing. This is not a clinical risk assessment and cannot establish safety.
+# It is a phrase match: it WILL miss real risk and may flag harmless context.
 CRISIS_PATTERNS = [
-    r"\b(kill myself|suicide|suicidal|end my life|don't want to live|do not want to live)\b",
-    r"\b(hurt myself|harm myself|self[- ]harm|cut myself|overdose)\b",
+    r"\b(kill(?:ing)? myself|suicid(?:e|al)|end(?:ing)? my (?:own )?life|take my own life)\b",
+    r"\b(?:i )?do(?:n't| not|nt) want to (?:live|be alive|be here)\b",
+    r"\b(want to die|wanna die|wish i (?:was|were) dead|better off dead|no reason to live)\b",
+    r"\b(?:life )?(?:is not|isn't|isnt) worth living\b",
+    r"\b(?:hurt|harm)(?:ing)? myself\b",
+    r"\b(?:self[- ]?harm|cut(?:ting)? myself|overdos(?:e|ing))\b",
 ]
+_COMPILED = [re.compile(p) for p in CRISIS_PATTERNS]
+_APOSTROPHES = str.maketrans({"\u2019": "'", "\u2018": "'", "\u02bc": "'", "\u00b4": "'", "`": "'"})
+
 CRISIS_MESSAGE = (
     "Your safety matters. AirSpace is not an emergency or crisis service. "
     "If you may act on thoughts of harming yourself, contact local emergency services "
@@ -13,6 +24,18 @@ CRISIS_MESSAGE = (
 )
 
 
-def may_need_immediate_support(text: str) -> bool:
-    normalized = re.sub(r"\s+", " ", text.lower())
-    return any(re.search(pattern, normalized) for pattern in CRISIS_PATTERNS)
+def get_crisis_message() -> str:
+    extra = settings.crisis_resources.strip()
+    return f"{CRISIS_MESSAGE} {extra}" if extra else CRISIS_MESSAGE
+
+
+def normalize(text: str) -> str:
+    text = unicodedata.normalize("NFKC", text).translate(_APOSTROPHES).lower()
+    return re.sub(r"\s+", " ", text)
+
+
+def may_need_immediate_support(text: str | None) -> bool:
+    if not text:
+        return False
+    normalized = normalize(text)
+    return any(p.search(normalized) for p in _COMPILED)
